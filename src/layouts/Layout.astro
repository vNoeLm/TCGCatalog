---
import '../styles/global.css';
import { Navigation } from '../components/Navigation';
import { GameSelector } from '../components/GameSelector';
import { LegalFooter } from '../components/LegalFooter';

interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Modern Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <!-- Immediate theme resolution to prevent FOUC -->
    <script is:inline>
      (function() {
        try {
          var override = localStorage.getItem('tcg_theme_override');
          var game = localStorage.getItem('tcg_active_game') || 'riftbound';
          var theme = (override === 'cyberpunk' || override === 'riftbound' || override === 'dark') ? override : (game === 'cyberpunk' ? 'cyberpunk' : 'riftbound');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen font-sans pb-16">
    <header style="border-bottom: 1px solid var(--border); background: var(--bg-header); backdrop-filter: blur(16px);" class="sticky top-0 z-50 transition-colors duration-200">
      <div style="max-width: 1400px; margin: 0 auto; padding: 10px clamp(12px, 2.5vw, 24px);" class="flex flex-nowrap justify-between items-center gap-2 sm:gap-4">
        <div class="flex items-center gap-2 sm:gap-3.5 shrink-0">
          <a href="/" class="flex items-center group transition" style="text-decoration: none;">
            <span class="text-base sm:text-xl font-black tracking-tight whitespace-nowrap text-zinc-100 group-hover:text-white transition-colors">
              TCG Vault
            </span>
          </a>
          <div class="h-4 sm:h-5 w-px bg-[var(--border)] opacity-60" />
          <GameSelector client:load />
        </div>
        <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
          <Navigation currentPath={pathname} client:load />
        </div>
      </div>
    </header>
    <slot />
    <LegalFooter client:load />
  </body>
</html>

<style is:global>
  :root {
    --font-inter: 'Inter', sans-serif;
  }
  body {
    font-family: var(--font-inter);
  }
</style>

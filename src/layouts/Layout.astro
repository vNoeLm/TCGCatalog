---
import '../styles/global.css';
import { Navigation } from '../components/Navigation';
import { GameSelector } from '../components/GameSelector';
import { LegalFooter } from '../components/LegalFooter';
import { BackToTop } from '../components/BackToTop';
import { CookieConsent } from '../components/CookieConsent';
import { MarketplaceCartDrawer } from '../components/marketplace/MarketplaceCartDrawer';

interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Body/UI: Inter. Headings: Space Grotesk - gives titles and card names some personality
         without touching the numbers, labels and buttons that need to stay purely legible. -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <!-- Immediate theme resolution to prevent FOUC -->
    <script is:inline>
      (function() {
        try {
          var override = localStorage.getItem('tcg_theme_override');
          // Cyberpunk TCG was removed: a browser still set to it switches back to Riftbound here,
          // before any part of the page reads the active game or saved catalog filters.
          if (localStorage.getItem('tcg_active_game') === 'cyberpunk') localStorage.setItem('tcg_active_game', 'riftbound');
          try {
            ['catalogFilters', 'catalogGame', 'inventoryFilters'].forEach(function (k) {
              var v = sessionStorage.getItem(k);
              if (v && v.indexOf('cyberpunk') !== -1) sessionStorage.removeItem(k);
            });
          } catch (e) {}
          var game = localStorage.getItem('tcg_active_game') || 'riftbound';
          var theme = (override === 'cyberpunk' || override === 'riftbound' || override === 'dark' || override === 'light') ? override : (game === 'cyberpunk' ? 'cyberpunk' : 'riftbound');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col font-sans">
    <header style="border-bottom: 1px solid var(--border); background: var(--bg-header); backdrop-filter: blur(16px);" class="sticky top-0 z-50 transition-colors duration-200">
      <div style="max-width: 1400px; margin: 0 auto; padding: 10px clamp(12px, 2.5vw, 24px);" class="flex flex-nowrap justify-between items-center gap-2 sm:gap-4">
        <div class="flex items-center gap-2 sm:gap-3.5 shrink-0">
          <a href="/" class="flex items-center group transition" style="text-decoration: none;">
            <span class="text-base sm:text-xl font-black tracking-tight whitespace-nowrap text-[var(--text-primary)] group-hover:text-[var(--text-accent)] transition-colors" style="font-family: var(--font-display);">
              TCG Vault
            </span>
          </a>
          <div class="h-4 sm:h-5 w-px bg-[var(--border)] opacity-60" />
          <GameSelector client:load />
        </div>
        <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
          <Navigation currentPath={pathname} client:load />
        </div>
      </div>
    </header>
    <!-- Takes the leftover height so the footer sits at the bottom of short pages. A plain block
         wrapper rather than making each page a flex item: pages center themselves with
         `margin: 0 auto` + max-width, which inside a flex column shrinks them to their content. -->
    <div class="flex-1 w-full">
      <slot />
    </div>
    <MarketplaceCartDrawer client:load />
    <LegalFooter client:load />
    <BackToTop client:load />
    <CookieConsent client:load />
    <script is:inline>
      // Publishes the sticky header's real height as --header-h (see --page-chrome-h in global.css).
      (function () {
        var header = document.querySelector('header');
        if (!header || !window.ResizeObserver) return;
        var publish = function () {
          document.documentElement.style.setProperty('--header-h', header.getBoundingClientRect().height + 'px');
        };
        publish();
        new ResizeObserver(publish).observe(header);
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --font-inter: 'Inter', sans-serif;
    --font-display: 'Space Grotesk', var(--font-inter);
  }
  body {
    font-family: var(--font-inter);
  }
  /* Titles get the display font; numbers, labels, badges and buttons stay in Inter for pure
     legibility - drawing the line at real heading tags keeps this from spreading everywhere. */
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
  }
</style>

# Copy to .env and fill in. Never commit the real file.

# Supabase project (Project Settings -> API)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only: API routes and the scripts in scripts/. Bypasses row level security, so
# never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protects /api/cron/sync-prices. Set the same value in the Vercel project settings; Vercel then
# sends it as "Authorization: Bearer <value>" on the daily cron call.
CRON_SECRET=a-long-random-string

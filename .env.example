# ─── Supabase Configuration ───────────────────────────────────────
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# ─── Barion Smart Gateway Configuration ──────────────────────────
# Get POS Key from Barion Shop management: https://secure.barion.com or https://secure.test.barion.com
BARION_POS_KEY=00000000-0000-0000-0000-000000000000
# The email address registered with your Barion merchant wallet:
BARION_PAYEE_EMAIL=merchant@yourdomain.com
# Environment: 'test' for Sandbox, 'prod' for Live Production:
BARION_ENVIRONMENT=test
